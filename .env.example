# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Project Settings > API, dentro do painel do Supabase)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings > API > service_role) — NUNCA leva o prefixo
# NEXT_PUBLIC_, e nunca deve ser usada em código que roda no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Hotmart — Ferramentas > Webhook > Autenticação (Hottok), e o ID de cada produto
# (aparece na URL do produto no painel da Hotmart)
HOTMART_HOTTOK=
HOTMART_ID_PRODUTO_ASSINATURA=
HOTMART_ID_PRODUTO_AULA_PARTICULAR=

# Kiwify — token que você mesmo escolhe e cola na URL do webhook ao cadastrar,
# e o ID de cada produto (painel da Kiwify > Produtos)
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_ID_PRODUTO_ASSINATURA=
KIWIFY_ID_PRODUTO_AULA_PARTICULAR=
